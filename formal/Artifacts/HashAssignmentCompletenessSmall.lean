noncomputable def assignment (i : Fin 54) (ambient : Assignment) : Assignment :=
  buildAssignment (kit i).scheme (kit i).powers (kit i).plan (kit i).stages ambient

theorem zero (i : Fin 54) (ambient : Assignment) :
    assignment i ambient 0 = ambient 0 :=
  buildAssignment_zero _ _ _ _ _

theorem inputs (i : Fin 54) (ambient : Assignment) (j : Fin (gate i).arity) :
    eval ((gate i).inputForms j) (assignment i ambient) =
      eval ((gate i).inputForms j) ambient :=
  buildAssignment_inputs _ _ _ (kit i).separate _ _ _

theorem complete (i : Fin 54) (ambient : Assignment) (hz : ambient 0 = 1) :
    (∀ c ∈ (gate i).constraints, c.Holds (assignment i ambient)) ∧
    eval (gate i).outputForm (assignment i ambient) =
      (kit i).scheme.hash (ambientInputs (gate i) ambient) :=
  buildAssignment_complete _ (kit i).affine (kit i).signs _ _ (kit i).separate
    _ (kit i).recovery ambient hz

theorem assignment_hash (i : Fin 54) (ambient : Assignment) (hz : ambient 0 = 1) :
    eval (gate i).outputForm (assignment i ambient) =
      (kit i).scheme.hash (ambientInputs (gate i) (assignment i ambient)) := by
  have hi : ambientInputs (gate i) (assignment i ambient) =
      ambientInputs (gate i) ambient := funext (inputs i ambient)
  rw [hi]
  exact (complete i ambient hz).2

/-- The constructed witness has the exact reference H2/H3 interface. -/
theorem hash_binding (i : Fin 54) (ambient : Assignment) (hz : ambient 0 = 1) :
    HashBinding (assignment i ambient) i := by
  fin_cases i
  · have hh := assignment_hash ⟨0, by decide⟩ ambient hz
    rw [show (kit ⟨0, by decide⟩).scheme = scheme3 from rfl] at hh
    erw [scheme3_hash, MSP.Poseidon.Optimized3.hash2_eq_reference] at hh
    change eval instance0.outputForm (assignment ⟨0, by decide⟩ ambient) = H2 (eval (inputAt instance0 0) (assignment ⟨0, by decide⟩ ambient)) (eval (inputAt instance0 1) (assignment ⟨0, by decide⟩ ambient))
    exact hh.trans (h2_reference _ _)
  · have hh := assignment_hash ⟨1, by decide⟩ ambient hz
    rw [show (kit ⟨1, by decide⟩).scheme = scheme3 from rfl] at hh
    erw [scheme3_hash, MSP.Poseidon.Optimized3.hash2_eq_reference] at hh
    change eval instance1.outputForm (assignment ⟨1, by decide⟩ ambient) = H2 (eval (inputAt instance1 0) (assignment ⟨1, by decide⟩ ambient)) (eval (inputAt instance1 1) (assignment ⟨1, by decide⟩ ambient))
    exact hh.trans (h2_reference _ _)
  · have hh := assignment_hash ⟨2, by decide⟩ ambient hz
    rw [show (kit ⟨2, by decide⟩).scheme = scheme4 from rfl] at hh
    erw [scheme4_hash, MSP.Poseidon.Optimized4.hash3_eq_reference] at hh
    change eval instance2.outputForm (assignment ⟨2, by decide⟩ ambient) = H3 (eval (inputAt instance2 0) (assignment ⟨2, by decide⟩ ambient)) (eval (inputAt instance2 1) (assignment ⟨2, by decide⟩ ambient)) (eval (inputAt instance2 2) (assignment ⟨2, by decide⟩ ambient))
    exact hh.trans (h3_reference _ _ _)
  · have hh := assignment_hash ⟨3, by decide⟩ ambient hz
