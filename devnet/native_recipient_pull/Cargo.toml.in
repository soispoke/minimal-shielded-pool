[package]
name = "msp-native-integration"
version = "0.1.0"
edition = "2024"

[dependencies]
ethrex-levm = { path = __ETHREX_LEVM__, default-features = false }
ethrex-common = { path = __ETHREX_COMMON__, default-features = false }
ethrex-crypto = { path = __ETHREX_CRYPTO__, default-features = false, features = ["std"] }
bytes = "1.6.0"
rustc-hash = "2.1.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
hex = "0.4"
